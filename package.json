{
  "name": "eventsfinder-mvp",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "local:start": "bash ./scripts/start-local.sh",
    "local:stop": "bash ./scripts/stop-local.sh",
    "local:status": "bash ./scripts/status-local.sh"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  },
  "prisma": {
    "seed": "pnpm --filter api seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.2"
  }
}
